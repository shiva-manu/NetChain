# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize

aws_region = "us-east-1"
environment = "production"
instance_type = "t3.medium"

# REQUIRED: Your SSH key name (create in AWS EC2 console first)
key_name = "my-netchain-key"

# Restrict SSH to your IP for better security
# Get your IP: curl ifconfig.me
allowed_ssh_cidr = ["YOUR_IP_ADDRESS/32"]

# Restrict monitoring to your IP
allowed_monitoring_cidr = ["YOUR_IP_ADDRESS/32"]

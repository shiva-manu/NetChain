# NetChain Website Environment Variables
# Copy this to .env.local and customize

# Production HTTPS Endpoints (Recommended)
VITE_NETCHAIN_RPC_URL=https://api.netchain.me
VITE_NETCHAIN_MONITORING_URL=https://api.netchain.me
VITE_NETCHAIN_WS_URL=wss://api.netchain.me/ws

# Direct EC2 Endpoints (HTTP - not recommended for production)
# VITE_NETCHAIN_RPC_URL=http://44.251.7.32:8545
# VITE_NETCHAIN_MONITORING_URL=http://44.251.7.32:9090
# VITE_NETCHAIN_WS_URL=ws://44.251.7.32:8546

# For local development (uncomment these)
# VITE_NETCHAIN_RPC_URL=http://127.0.0.1:8545
# VITE_NETCHAIN_MONITORING_URL=http://127.0.0.1:9090
# VITE_NETCHAIN_WS_URL=ws://127.0.0.1:8546

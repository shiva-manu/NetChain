[Unit]
Description=NetChain Node - Proof of Internet Blockchain
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/netchain
Environment="RUST_LOG=info"
ExecStart=/opt/netchain/target/release/netchain
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netchain

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/netchain/data

[Install]
WantedBy=multi-user.target
